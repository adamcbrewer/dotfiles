{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "plugins": ["./herdr-opencode"],
  "diffs": {
    "wrap": "word"
  },
  "prompt": {
    "paste": "compact"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true,
  "attention": {
    "sound": false
  }
}
