{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "providers": {
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "settings": {
            "reasoningEffort": "xhigh"
          }
        },
        "gpt-6-astra": {
          "settings": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  },
  "agents": {
    "build": {
      "model": "openai/gpt-6.1-sol#xhigh"
    },
    "plan": {
      "model": "openai/gpt-6.1-sol#xhigh"
    },
    "general": {
      "model": "openai/gpt-6.1-sol#xhigh"
    },
    "explore": {
      "model": "openai/gpt-5.6-terra-fast#medium"
    }
  }
}
