#!/bin/bash
set -eu

skills_cli='skills@1.5.15'
temp_dir=$(mktemp -d)
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/sync-opencode-skills
managed_skills_file=$state_dir/managed-skills
if [ -n "${XDG_STATE_HOME:-}" ]; then
  skill_lock_file=$XDG_STATE_HOME/skills/.skill-lock.json
else
  skill_lock_file=$HOME/.agents/.skill-lock.json
fi
desired_skills=(
  agent-browser
  domain-web
  frontend-design
  golang-code-style
  golang-concurrency
  golang-database
  golang-error-handling
  golang-modernize
  golang-observability
  golang-performance
  golang-project-layout
  golang-security
  golang-testing
  grill-me
  grilling
  m05-type-driven
  m14-mental-model
  retro
  rust-best-practices
  rust-patterns
  rust-testing
  security-review
  next-best-practices
  ui-ux-pro-max
  ux-heuristics-audit
  vercel-react-best-practices
  web-design-guidelines
  writing-for-agents
)
trap 'rm -rf -- "$temp_dir"' EXIT

remove_managed_skill() {
  local skill=$1
  if [[ ! $skill =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
    printf 'Invalid managed skill name: %s\n' "$skill" >&2
    exit 1
  fi

  npx --yes "$skills_cli" remove --global --yes "$skill"

  # The CLI skips lock-only entries when the installed directory is already gone.
  if [ -f "$skill_lock_file" ]; then
    node -e '
      const fs = require("node:fs");
      const [path, name] = process.argv.slice(1);
      const lock = JSON.parse(fs.readFileSync(path, "utf8"));
      if (lock.skills && Object.hasOwn(lock.skills, name)) {
        delete lock.skills[name];
        const temporaryPath = `${path}.${process.pid}.tmp`;
        fs.writeFileSync(temporaryPath, `${JSON.stringify(lock, null, 2)}\n`);
        fs.renameSync(temporaryPath, path);
      }
    ' "$skill_lock_file" "$skill"
  fi
}

is_desired_skill() {
  local candidate=$1
  local desired_skill
  for desired_skill in "${desired_skills[@]}"; do
    [ "$candidate" = "$desired_skill" ] && return 0
  done
  return 1
}

mkdir -p "$state_dir"

configure_grill_me() {
  node - "$1" <<'JS'
const fs = require("node:fs");
const path = require("node:path");
const directory = process.argv[2];
const skillPath = path.join(directory, "SKILL.md");
const skill = fs.readFileSync(skillPath, "utf8")
  .replace(/^description:.*$/m, "description: Interview the user to sharpen a plan or design. Use when the user asks to be grilled or interviewed about it.")
  .replace(/^disable-model-invocation: true\n/m, "");
fs.writeFileSync(skillPath, skill);
const agentPath = path.join(directory, "agents/openai.yaml");
const agent = fs.readFileSync(agentPath, "utf8")
  .replace("allow_implicit_invocation: false", "allow_implicit_invocation: true");
fs.writeFileSync(agentPath, agent);
JS
}

install_skills() {
  local repository=$1
  local revision=$2
  local checkout="$temp_dir/$3"
  local source_path=$4
  shift 4

  git init --quiet "$checkout"
  git -C "$checkout" remote add origin "$repository"
  git -C "$checkout" fetch --quiet --depth 1 origin "$revision"
  git -C "$checkout" checkout --quiet --detach FETCH_HEAD
  if [ "$checkout" = "$temp_dir/mattpocock-skills" ]; then
    configure_grill_me "$checkout/$source_path/productivity/grill-me"
  fi
  case "$checkout" in
    "$temp_dir/uxcel-product-skills"|"$temp_dir/ui-ux-pro-max")
      cp "$checkout/LICENSE" "$checkout/$source_path/LICENSE"
      ;;
  esac
  npx --yes "$skills_cli" add "$checkout/$source_path" --global --agent opencode --yes --copy "$@"
}

install_skills https://github.com/vercel-labs/agent-browser.git acbc22bdc5d4f6c5a88d97d4a4745d3c5eb0591f agent-browser . --skill agent-browser
install_skills https://github.com/anthropics/skills.git 8a1541c4a3ffa5a20a5a91de0dcf3f0bab1d1ef4 anthropics-skills . --skill frontend-design
install_skills https://github.com/uxcel-lab/product-skills.git 5007cd0241ccaa51ae2e4681f9618912dc10e239 uxcel-product-skills ux/audits/heuristics --skill ux-heuristics-audit
install_skills https://github.com/nextlevelbuilder/ui-ux-pro-max-skill.git 28b3b8dee8c976df4fa3e94aed4e092ad43fcb03 ui-ux-pro-max .claude/skills/ui-ux-pro-max --skill ui-ux-pro-max
install_skills https://github.com/getsentry/skills.git e7a87fa72645158f9b5e722cbb1c7e09266f48f1 sentry-skills . --skill security-review
install_skills https://github.com/vercel-labs/openreview.git 672deb21e70e471e0536d5ad7a67c14b8359e97e openreview .agents/skills --skill next-best-practices --skill web-design-guidelines
install_skills https://github.com/vercel-labs/agent-skills.git 063bee94c3f4df8453406c830b0a7df0f2860278 vercel-agent-skills skills --skill vercel-react-best-practices
install_skills https://github.com/affaan-m/ecc.git e482e579415fde18357cafce70f177ae19fd7f03 ecc-rust skills --skill rust-patterns --skill rust-testing
install_skills https://github.com/actionbook/rust-skills.git 5c40d3ad785193231b7d0dbfb8e1eb447e5edd94 actionbook-rust skills --skill domain-web --skill m05-type-driven --skill m14-mental-model
install_skills https://github.com/apollographql/skills.git 6b51584fb648d4463b1573e8e9c325c24f44c5b1 apollo-skills skills --skill rust-best-practices
install_skills https://github.com/samber/cc-skills-golang.git 8e899e20ff0cd4dc524af3993e4c62d8ee8c5717 samber-go skills --skill golang-code-style --skill golang-concurrency --skill golang-database --skill golang-error-handling --skill golang-modernize --skill golang-observability --skill golang-performance --skill golang-project-layout --skill golang-security --skill golang-testing
install_skills https://github.com/mattpocock/skills.git f6abdeb8dd2a9be64f924ab44c7af374cb76726d mattpocock-skills skills --skill grill-me --skill grilling --skill retro --skill writing-for-agents

if [ -f "$managed_skills_file" ]; then
  while IFS= read -r skill; do
    if [ -n "$skill" ] && ! is_desired_skill "$skill"; then
      remove_managed_skill "$skill"
    fi
  done < "$managed_skills_file"
fi

printf '%s\n' "${desired_skills[@]}" > "$managed_skills_file"
