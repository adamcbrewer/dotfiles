// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-Escape": "workspace::ToggleZoom",
      // "ctrl-p": "file_finder::Toggle",
    },
  },
  {
    "context": "Pane",
    "bindings": {
      // Focus left/right pane
      "shift-ctrl-PageUp": "workspace::ActivatePaneLeft",
      "shift-ctrl-PageDown": "workspace::ActivatePaneRight",
      // Move tabs to left/right pane (in Pane context so it works from ProjectPanel too)
      "super-ctrl-PageDown": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "right" },
      ],
      "super-ctrl-PageUp": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "left" },
      ],
    },
  },
  {
    "context": "Editor",
    "bindings": {
      // Duplicate line
      "ctrl-shift-d": ["workspace::SendKeystrokes", "ctrl-shift-alt-down"],
      // Dive into definition
      "super-ctrl-down": "editor::GoToDefinition",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "enter": "project_panel::OpenPermanent",
      "ctrl-enter": ["workspace::SendKeystrokes", "enter super-ctrl-pagedown"],
      // Escape hatch: jump back to editor panes when accidentally focused here
      "shift-ctrl-PageDown": "workspace::ActivatePaneRight",
    },
  },
]
